# Keep this value on the server. It is never exposed to the browser.
BFL_API_KEY=
# Configure an official BFL image endpoint when the generation worker is enabled.
BFL_IMAGE_ENDPOINT=
# Optional FLUX 3 video endpoint; blank uses https://api.bfl.ai/v1/flux-3-video.
BFL_VIDEO_ENDPOINT=
# FLUX 3 quality: "final" (draft:false, fhd 1920x1088) or "draft" (fast hd preview). Blank = defaults:
# storyboards/presets/stories + the first quick clip = final; edits/appends/continuations = draft.
# BFL_VIDEO_QUALITY applies everywhere; the _STORYBOARD / _CLIP / _EDIT variants override it per context.
BFL_VIDEO_QUALITY=
BFL_VIDEO_QUALITY_STORYBOARD=
BFL_VIDEO_QUALITY_CLIP=
BFL_VIDEO_QUALITY_EDIT=
# Storyboards render every scene as a real FLUX 3 image-to-video shot ("cinematic", default) or the legacy
# still + zoom slideshow ("still").
STORYBOARD_RENDER_MODE=
# Cinematic renderer: parallel scene videos (default 3), crossfade seconds (default 0.4), captions "final" | "none".
CINEMATIC_CONCURRENCY=
CINEMATIC_CROSSFADE_SECONDS=
CINEMATIC_CAPTIONS=
# Stories: "0" generates each story's 3 stills independently instead of conditioning beats 2-3 on beat 1.
STORY_REFERENCE_STILLS=
# Quick-clip prompt writer: blank = cinematic phone-footage shot writer; "basic" = the older generic writer.
VIDEO_PROMPT_WRITER=

# Keep this value on the server. It is never exposed to the browser.
RAWTREE_API_KEY=
# Optional: restrict the RawTree agent to one simple table identifier.
RAWTREE_TABLE=
# Publish finished project videos (metadata + chunked MP4) to slop_human_video_* tables; "0" disables.
RAWTREE_PUBLISH_VIDEOS=1
# Videos above this size (MB) publish metadata only (chunk_count 0).
RAWTREE_MAX_VIDEO_MB=25
# Log every user prompt (slop_human_user_prompts) and feed a per-user context block to the LLM calls; "0" disables.
RAWTREE_PUBLISH_PROMPTS=1

# Keep this value on the server. Used by core/ and the company agent (agent/) for Liquid.
OPENROUTER_API_KEY=
# Optional: OpenRouter model; blank uses liquid/lfm-2.5-2.6b:free. AGENT_MODEL overrides it for agent/ only.
OPENROUTER_MODEL=
AGENT_MODEL=

# Company agent (python -m agent worker). All optional; values are clamped to safe ranges.
AGENT_MAX_TOKENS=8000
AGENT_MAX_STEPS=8
AGENT_OBSERVATION_CHARS=12000
AGENT_CONTEXT_CHARS=48000
AGENT_PROMPT_TIMEOUT_S=12
AGENT_INTERVAL_S=300
AGENT_REFRESH_S=1800
AGENT_PORT=8765
# Research sessions (POST /research on the agent; see agent/README.md). LFM 2.5 allows 8192 output tokens per call.
RESEARCH_MAX_PAGES=12
RESEARCH_MAX_STEPS=20
RESEARCH_MAX_ROUNDS=6
RESEARCH_INTERVAL_S=60
RESEARCH_MAX_TOKENS=8192
RESEARCH_OBSERVATION_CHARS=16000
RESEARCH_CONTEXT_CHARS=120000
RESEARCH_REASONING=medium
# Liquid calls in flight at once for page extraction and competitor research (1-4). LFM always reasons first
# (5-20 s per page); higher is faster but meets free-tier 429s sooner.
RESEARCH_PARALLEL=3
# Competitor research + storylines (agent/story_api.py). Pages are read through Nimble (POST /v2/extract) when
# NIMBLE_API_KEY is set; RESEARCH_FETCHER=auto (Nimble if keyed, else direct httpx) | nimble | direct.
# Allowlist and robots.txt checks apply either way. RESEARCH_MAX_COMPETITORS=0 turns competitor research off.
NIMBLE_API_KEY=
RESEARCH_FETCHER=auto
RESEARCH_MAX_COMPETITORS=3
RESEARCH_COMPETITOR_PAGES=3
RESEARCH_DETECT_TIMEOUT_S=10
RESEARCH_STORY_TIMEOUT_S=90
# Next.js side: where the agent listens (loopback only), how long to wait, and a kill switch (1 = off).
AGENT_URL=http://127.0.0.1:8765
AGENT_TIMEOUT_MS=15000
AGENT_DISABLED=

# Logging (docs/LOGGING.md). Console level for web + agent: debug | info | warn | error (default info).
# LOG_LEVEL=info
# NDJSON file level (default debug) — files in generation-video/output/logs/, kept LOG_RETENTION_DAYS (default 14).
# LOG_FILE_LEVEL=debug
# LOG_COLOR=1
